# Copie este arquivo para .env e preencha com as SUAS credenciais.
# O .env nunca deve ser compartilhado nem commitado - cada pessoa usa o proprio.

# Login do portal da Selbetti: https://www.selbetti.com.br/canal_cliente_novo/login
SELBETTI_USER=
SELBETTI_PASS=

# Login do portal da Simpress: https://ux.simpress.com.br/ng/autenticacao/login
SIMPRESS_USER=
SIMPRESS_PASS=

# Jira - gere um token pessoal em:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://mercadolibre.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
